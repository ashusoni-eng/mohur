# Public address of this server. Used in payment links, webhooks and OAuth redirects.
APP_URL=http://localhost:4100

# 32+ random characters. Encrypts Gmail credentials and account numbers at rest.
# Leave empty and Mohur creates data/secret.key for you on first run. Back it up.
APP_SECRET=

# Set to "closed" to stop new accounts being created on this server.
SIGNUPS=open

# Repository shown on the home page with its star count.
GITHUB_REPO=ashusoni-eng/mohur

# Where the SQLite database lives.
DATA_DIR=./data

# Optional: enables the "Connect with Google" button (Gmail API, read-only).
# Redirect URI to register: {APP_URL}/api/mail/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to 1 behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0

# Email Lab "inject" button. On in development, off in production unless set to 1.
ENABLE_SIMULATOR=
